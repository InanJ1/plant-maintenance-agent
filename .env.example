# OpenAI-compatible LLM endpoint (shared local Ollama in Docker by default).
# machina's LiteLLM provider has no base-URL setting; corvane_pm/llm.py maps these
# onto LiteLLM's api_base / api_key and calls the model as "openai/<LLM_MODEL>".
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
# Embeddings for the manuals index, same endpoint (/v1/embeddings).
EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_S=600
LLM_MAX_TOKENS=400
